        <mxCell id="layer0t" parent="layer0" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacingLeft=8;" value="Màn hình M1 Tạo phiếu · M2 Danh sách phiếu · M3 Chi tiết phiếu (React)&#xa;CustomerController, TicketController (REST API, FastAPI router)&#xa;Trách nhiệm: nhận dữ liệu nhập, hiển thị kết quả và thông báo lỗi; KHÔNG chứa quy tắc nghiệp vụ" vertex="1">
