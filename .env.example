# Local PostgreSQL connection (Docker Compose overrides DATABASE_URL for the API).
DATABASE_URL=postgresql+psycopg://smart_crm:change-this-local-password@localhost:5432/smart_crm_l2
TEST_DATABASE_URL=postgresql+psycopg://smart_crm:change-this-local-password@localhost:5432/smart_crm_test

# PostgreSQL container
POSTGRES_DB=smart_crm_l2
POSTGRES_USER=smart_crm
POSTGRES_PASSWORD=change-this-local-password
DB_PORT=5432

# API
APP_PORT=8000

# Prototype account. Replace these local sample values in .env.
DEMO_USERNAME=demo
DEMO_PASSWORD=change-this-demo-password
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_MINUTES=30
